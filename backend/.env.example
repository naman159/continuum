# Database
DATABASE_URL=postgresql://localhost/novel_wiki

# Chat / extraction LLM (any LiteLLM-supported model string)
DEFAULT_MODEL=gemini/gemini-3.1-flash-lite
LLM_TEMPERATURE=0.1

# Embeddings
# gemini-embedding-2 supports Matryoshka dims: 768, 1536, or 3072.
# EMBEDDING_DIMENSIONS is substituted into schema.sql's VECTOR(__EMBEDDING_DIM__)
# at init-db time -- do not hand-edit the schema. Changing it means re-running
# init-db against an empty database and re-embedding everything: init-db refuses
# to run against existing vector columns of a different width.
EMBEDDING_MODEL=gemini/gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Auth — LiteLLM reads this directly for gemini/ routes
GEMINI_API_KEY=your-gemini-api-key-here

# Chunking
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Set to true to skip LLM calls and use the deterministic mock extractor
USE_MOCK_LLM=false
