# Database
DATABASE_URL=postgresql://localhost/novel_wiki

# Chat / extraction LLM (any LiteLLM-supported model string)
DEFAULT_MODEL=gemini/gemini-3.1-flash-lite
LLM_TEMPERATURE=0.1

# Embeddings
# gemini-embedding-2 supports Matryoshka dims: 768, 1536, or 3072.
# If you change EMBEDDING_DIMENSIONS, update VECTOR(...) in db/schema.sql
# and re-init the database.
EMBEDDING_MODEL=gemini/gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Auth — LiteLLM reads this directly for gemini/ routes
GEMINI_API_KEY=AIzaSyBFXu3upwtsK_vBTVT0u32iw5ev6ATzQ_s

# Chunking
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Set to true to skip LLM calls and use the deterministic mock extractor
USE_MOCK_LLM=false
